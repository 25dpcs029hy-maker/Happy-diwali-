
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Happy Diwali 🪔</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    height: 100vh;
    overflow: hidden;
    background: radial-gradient(circle, #251008, #050505 75%);
    display: flex;
    justify-content: center;
    align-items: center;
    font-family: Georgia, serif;
    color: white;
}

.container {
    text-align: center;
    position: relative;
    z-index: 2;
}

h1 {
    font-size: clamp(45px, 10vw, 100px);
    color: #ff8c27;
    text-shadow:
        0 0 10px #ff7b00,
        0 0 25px #ff6500,
        0 0 50px #ff4500,
        0 0 90px #ff2200;
    animation: glow 2s infinite alternate;
    letter-spacing: 5px;
}

h2 {
    color: #ffd36a;
    margin-top: 20px;
    font-size: clamp(20px, 4vw, 35px);
    text-shadow: 0 0 15px orange;
}

p {
    margin-top: 20px;
    color: #fff1c2;
    font-size: 18px;
}

@keyframes glow {
    from {
        text-shadow: 0 0 10px orange, 0 0 30px red;
    }
    to {
        text-shadow: 0 0 25px yellow,
                     0 0 50px orange,
                     0 0 90px red;
    }
}

/* Decorative glowing lights */
.lights {
    position: absolute;
    top: 0;
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: space-evenly;
    z-index: 1;
}

.light {
    width: 5px;
    height: 45%;
    background: linear-gradient(
        transparent, #ff5a00, #ffb347, transparent
    );
    box-shadow: 0 0 15px #ff6500;
    animation: flicker 1.5s infinite alternate;
}

.light:nth-child(even) {
    height: 30%;
    animation-delay: 0.5s;
}

@keyframes flicker {
    from { opacity: 0.3; }
    to { opacity: 1; }
}

/* Diyas */
.diya {
    font-size: 55px;
    margin-top: 35px;
    animation: float 2s infinite ease-in-out;
    filter: drop-shadow(0 0 15px orange);
}

@keyframes float {
    50% { transform: translateY(-12px); }
}

/* Sparkles */
.sparkle {
    position: absolute;
    color: #ffd700;
    font-size: 20px;
    animation: sparkle 3s infinite;
    pointer-events: none;
}

@keyframes sparkle {
    0% { opacity: 0; transform: scale(0.3); }
    50% { opacity: 1; transform: scale(1.5); }
    100% { opacity: 0; transform: scale(0.3); }
}

</style>
</head>

<body>

<div class="lights">
    <div class="light"></div>
    <div class="light"></div>
    <div class="light"></div>
    <div class="light"></div>
    <div class="light"></div>
    <div class="light"></div>
    <div class="light"></div>
    <div class="light"></div>
</div>

<div class="container">
    <h1>HAPPY<br>DIWALI</h1>

    <h2>🪔 शुभ दीपावली 🪔</h2>

    <p>May your life shine with happiness!</p>

    <div class="diya">🪔</div>
</div>

<script>
function createSparkle() {
    const sparkle = document.createElement("div");

    sparkle.className = "sparkle";
    sparkle.innerHTML = "✦";

    sparkle.style.left = Math.random() * 100 + "vw";
    sparkle.style.top = Math.random() * 100 + "vh";
    sparkle.style.animationDuration =
        (1 + Math.random() * 3) + "s";

    document.body.appendChild(sparkle);

    setTimeout(() => {
        sparkle.remove();
    }, 3000);
}

setInterval(createSparkle, 250);
</script>

</body>
</html>
                                
